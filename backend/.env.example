# Copy this file to ".env" in the same folder and fill in real values.
# ".env" itself must NEVER be committed to git (see .gitignore).

ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./projectsync.db

# --- CORS: comma-separated frontend origins allowed to call this API ---
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- AI ---
# "demo" = local rule-based fallback (no key needed, always works for demos)
# "real" = calls an external LLM API using AI_API_KEY below
AI_MODE=demo
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-5

# --- Matching confidence thresholds ---
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60

# --- Delay / variance thresholds ---
AT_RISK_VARIANCE=-10
DELAYED_VARIANCE=-10

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads
